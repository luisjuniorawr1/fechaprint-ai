FECHAPRINT_DATA_DIR=/data
FECHAPRINT_MAX_UPLOAD_MB=80
FECHAPRINT_OCR_SIMILARITY=0.84

# Real-ESRGAN: {input} {output_dir} {scale}
FECHAPRINT_REALESRGAN_CMD=
# PaddleOCR wrapper prints text/JSON to stdout: {input}
FECHAPRINT_PADDLEOCR_CMD=
# Image providers write JPG/PNG/WEBP into {output_dir}.
# Available placeholders: {input} {output_dir} {ratio} {prompt} {width} {height}
FECHAPRINT_LAMA_CMD=
FECHAPRINT_POWERPAINT_CMD=
FECHAPRINT_SEEDVR2_CMD=
FECHAPRINT_QWEN_CMD=
FECHAPRINT_GFPGAN_CMD=

FECHAPRINT_ENABLE_QWEN=1
FECHAPRINT_ENABLE_SEEDVR2=1
FECHAPRINT_ENABLE_POWERPAINT=1
FECHAPRINT_ENABLE_LAMA=1
FECHAPRINT_ENABLE_GFPGAN=0
