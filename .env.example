FECHAPRINT_DATA_DIR=/data
FECHAPRINT_MAX_UPLOAD_MB=80
FECHAPRINT_WORKERS=1
FECHAPRINT_REALESRGAN_TILE=256
FECHAPRINT_OCR_SIMILARITY=0.90
FECHAPRINT_MIN_EDGE_RATIO=0.82
FECHAPRINT_MAX_VISUAL_DIFF=0.24
FECHAPRINT_MAX_CROP_FRACTION=0.22
FECHAPRINT_ENABLE_OCR=1

# Choose ONE Real-ESRGAN integration:
# 1) Custom wrapper with placeholders {input} {output_dir} {scale} {tile}
FECHAPRINT_REALESRGAN_CMD=
# 2) Put realesrgan-ncnn-vulkan on PATH
# 3) Point to the official Python inference script
FECHAPRINT_REALESRGAN_SCRIPT=

# Optional OCR wrapper; otherwise the installed paddleocr Python package/CLI is detected.
FECHAPRINT_PADDLEOCR_CMD=
